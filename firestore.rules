rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isActiveUser() {
      return hasProfile() &&
        currentUser().status == 'active';
    }

    function isActiveAdmin() {
      return hasProfile() &&
        currentUser().role == 'admin' &&
        currentUser().status == 'active';
    }

    function validUserData(userId, data) {
      return data.keys().hasAll([
          'uid',
          'email',
          'fullName',
          'employeeCode',
          'role',
          'status',
          'officeId',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'email',
          'fullName',
          'employeeCode',
          'role',
          'status',
          'officeId',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string &&
        data.uid == userId &&
        data.email is string &&
        data.email.size() > 3 &&
        data.email.size() <= 254 &&
        data.fullName is string &&
        data.fullName.size() >= 3 &&
        data.fullName.size() <= 100 &&
        data.employeeCode is string &&
        data.employeeCode.size() >= 3 &&
        data.employeeCode.size() <= 30 &&
        data.role in ['admin', 'employee'] &&
        data.status in ['active', 'inactive', 'pending'] &&
        (
          data.officeId == null ||
          (
            data.officeId is string &&
            data.officeId.size() >= 3 &&
            data.officeId.size() <= 50
          )
        ) &&
        (
          data.role == 'admin' ||
          data.status != 'active' ||
          data.officeId is string
        ) &&
        data.schemaVersion is int &&
        data.schemaVersion == 1 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function validUserOfficeAssignment(data) {
      return data.officeId == null ||
        (
          data.officeId is string &&
          exists(
            /databases/$(database)/documents/offices/$(data.officeId)
          ) &&
          (
            data.role == 'admin' ||
            data.status != 'active' ||
            get(
              /databases/$(database)/documents/offices/$(data.officeId)
            ).data.active == true
          )
        );
    }

    function canReadOffice(officeId) {
      return isActiveAdmin() ||
        (
          isActiveUser() &&
          currentUser().officeId == officeId
        );
    }

    function validOfficeData(data) {
      return data.keys().hasAll([
          'name',
          'address',
          'location',
          'radiusMeters',
          'maxAccuracyMeters',
          'timezone',
          'active',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name',
          'address',
          'location',
          'radiusMeters',
          'maxAccuracyMeters',
          'timezone',
          'active',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ]) &&
        data.name is string &&
        data.name.size() >= 3 &&
        data.name.size() <= 100 &&
        data.address is string &&
        data.address.size() >= 5 &&
        data.address.size() <= 200 &&
        data.location is latlng &&
        data.radiusMeters is number &&
        data.radiusMeters >= 20 &&
        data.radiusMeters <= 500 &&
        data.maxAccuracyMeters is number &&
        data.maxAccuracyMeters >= 5 &&
        data.maxAccuracyMeters <= 100 &&
        data.timezone == 'America/Lima' &&
        data.active is bool &&
        data.schemaVersion is int &&
        data.schemaVersion == 1 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function attendanceOffice(officeId) {
      return get(
        /databases/$(database)/documents/offices/$(officeId)
      ).data;
    }

    function isActiveOffice(officeId) {
      return officeId is string &&
        exists(
          /databases/$(database)/documents/offices/$(officeId)
        ) &&
        attendanceOffice(officeId).active == true &&
        attendanceOffice(officeId).schemaVersion == 1;
    }

    function validAttendanceBase(attendanceId, data) {
      return data.keys().hasAll([
          'userId',
          'officeId',
          'workDate',
          'mode',
          'status',
          'checkIn',
          'checkOut',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'officeId',
          'workDate',
          'mode',
          'status',
          'checkIn',
          'checkOut',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ]) &&
        data.userId is string &&
        data.userId.size() > 0 &&
        data.userId.size() <= 128 &&
        data.officeId is string &&
        data.officeId.size() >= 3 &&
        data.officeId.size() <= 50 &&
        data.workDate is string &&
        data.workDate.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        ) &&
        attendanceId == data.userId + '_' + data.workDate &&
        data.mode == 'onsite' &&
        data.status in ['checked-in', 'completed'] &&
        data.checkIn is map &&
        (
          data.checkOut == null ||
          data.checkOut is map
        ) &&
        data.schemaVersion is int &&
        data.schemaVersion == 1 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function validAttendanceMark(
      mark,
      officeData,
      userId,
      attendanceId,
      eventName
    ) {
      return mark is map &&
        mark.keys().hasAll([
          'capturedAt',
          'recordedAt',
          'location',
          'accuracyMeters',
          'distanceMeters',
          'isMocked',
          'evidencePath'
        ]) &&
        mark.keys().hasOnly([
          'capturedAt',
          'recordedAt',
          'location',
          'accuracyMeters',
          'distanceMeters',
          'isMocked',
          'evidencePath'
        ]) &&
        mark.capturedAt is timestamp &&
        mark.recordedAt is timestamp &&
        mark.recordedAt == request.time &&
        mark.capturedAt >=
          request.time - duration.value(10, 'm') &&
        mark.capturedAt <=
          request.time + duration.value(2, 'm') &&
        mark.location is latlng &&
        mark.accuracyMeters is number &&
        mark.accuracyMeters > 0 &&
        mark.accuracyMeters <= officeData.maxAccuracyMeters &&
        mark.distanceMeters is number &&
        mark.distanceMeters >= 0 &&
        mark.distanceMeters <= officeData.radiusMeters &&

        // Firestore calcula la distancia real entre el GPS y la sede.
        mark.location.distance(officeData.location) <=
          officeData.radiusMeters &&

        // El valor calculado por Flutter debe coincidir, con 2 m de tolerancia.
        math.abs(
          mark.distanceMeters -
          mark.location.distance(officeData.location)
        ) <= 2 &&

        mark.isMocked is bool &&
        mark.isMocked == false &&
        mark.evidencePath is string &&
        mark.evidencePath ==
          'attendanceEvidence/' +
          userId +
          '/' +
          attendanceId +
          '/' +
          eventName +
          '.jpg';
    }

    function canReadAttendance(data) {
      return isActiveAdmin() ||
        (
          isActiveUser() &&
          data.userId == request.auth.uid
        );
    }

    function isOwnAttendanceId(attendanceId) {
      return isActiveUser() &&
        attendanceId.size() == request.auth.uid.size() + 11 &&
        attendanceId[0:request.auth.uid.size() + 1] ==
          request.auth.uid + '_' &&
        attendanceId[
          request.auth.uid.size() + 1:attendanceId.size()
        ].matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    match /users/{userId} {
      allow get: if isSignedIn() &&
        (request.auth.uid == userId || isActiveAdmin());

      allow list: if isActiveAdmin();

      allow create: if isActiveAdmin() &&
        validUserData(userId, request.resource.data) &&
        validUserOfficeAssignment(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if isActiveAdmin() &&
        validUserData(userId, request.resource.data) &&
        validUserOfficeAssignment(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName',
          'employeeCode',
          'role',
          'status',
          'officeId',
          'updatedAt'
        ]) &&
        request.resource.data.updatedAt == request.time &&
        (
          request.auth.uid != userId ||
          (
            request.resource.data.role == resource.data.role &&
            request.resource.data.status == resource.data.status
          )
        );

      allow delete: if false;
    }

    match /offices/{officeId} {
      allow get: if canReadOffice(officeId);
      allow list: if isActiveAdmin();

      allow create: if isActiveAdmin() &&
        validOfficeData(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if isActiveAdmin() &&
        validOfficeData(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'address',
          'location',
          'radiusMeters',
          'maxAccuracyMeters',
          'timezone',
          'active',
          'updatedAt'
        ]) &&
        request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /attendances/{attendanceId} {
      // Autoriza el documento diario propio aunque todavía no exista.
      // La autorización usa el UID incluido en el ID, no resource.data.
      allow get: if isActiveAdmin() ||
        isOwnAttendanceId(attendanceId);

      allow list: if
        request.query.limit != null &&
        request.query.limit <= 50 &&
        canReadAttendance(resource.data);

      allow create: if
        isActiveUser() &&
        validAttendanceBase(
          attendanceId,
          request.resource.data
        ) &&
        request.auth.uid == request.resource.data.userId &&
        currentUser().officeId ==
          request.resource.data.officeId &&
        isActiveOffice(request.resource.data.officeId) &&
        request.resource.data.status == 'checked-in' &&
        request.resource.data.checkOut == null &&
        validAttendanceMark(
          request.resource.data.checkIn,
          attendanceOffice(request.resource.data.officeId),
          request.resource.data.userId,
          attendanceId,
          'check-in'
        ) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if
        isActiveUser() &&
        validAttendanceBase(
          attendanceId,
          request.resource.data
        ) &&
        request.auth.uid == resource.data.userId &&
        currentUser().officeId == resource.data.officeId &&
        isActiveOffice(resource.data.officeId) &&
        resource.data.status == 'checked-in' &&
        resource.data.checkOut == null &&
        request.resource.data.status == 'completed' &&
        request.resource.data.checkOut is map &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'checkOut',
          'updatedAt'
        ]) &&
        validAttendanceMark(
          request.resource.data.checkOut,
          attendanceOffice(resource.data.officeId),
          resource.data.userId,
          attendanceId,
          'check-out'
        ) &&
        request.resource.data.checkOut.capturedAt >=
          resource.data.checkIn.recordedAt &&
        request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
