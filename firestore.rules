rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isActiveAdmin() {
      return hasProfile() &&
        currentUser().role == 'admin' &&
        currentUser().status == 'active';
    }

    function validUserData(userId, data) {
      return data.keys().hasAll([
          'uid',
          'email',
          'fullName',
          'employeeCode',
          'role',
          'status',
          'officeId',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'email',
          'fullName',
          'employeeCode',
          'role',
          'status',
          'officeId',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string &&
        data.uid == userId &&
        data.email is string &&
        data.email.size() > 3 &&
        data.email.size() <= 254 &&
        data.fullName is string &&
        data.fullName.size() >= 3 &&
        data.fullName.size() <= 100 &&
        data.employeeCode is string &&
        data.employeeCode.size() >= 3 &&
        data.employeeCode.size() <= 30 &&
        data.role in ['admin', 'employee'] &&
        data.status in ['active', 'inactive', 'pending'] &&
        (data.officeId == null || data.officeId is string) &&
        data.schemaVersion is int &&
        data.schemaVersion == 1 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /users/{userId} {
      // Cada trabajador puede consultar únicamente su propio perfil.
      // Un administrador activo puede consultar todos los perfiles.
      allow get: if isSignedIn() &&
        (request.auth.uid == userId || isActiveAdmin());

      allow list: if isActiveAdmin();

      // Solo un administrador activo puede registrar trabajadores.
      allow create: if isActiveAdmin() &&
        validUserData(userId, request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      // UID, correo y fecha de creación permanecen inmutables.
      allow update: if isActiveAdmin() &&
        validUserData(userId, request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName',
          'employeeCode',
          'role',
          'status',
          'officeId',
          'updatedAt'
        ]) &&
        request.resource.data.updatedAt == request.time &&
        (
          request.auth.uid != userId ||
          (
            request.resource.data.role == resource.data.role &&
            request.resource.data.status == resource.data.status
          )
        );

      // Los perfiles se desactivan; no se eliminan.
      allow delete: if false;
    }

    // Todo módulo no definido permanece bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}