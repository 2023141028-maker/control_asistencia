rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isActiveAdmin() {
      return hasProfile() &&
        currentUser().role == 'admin' &&
        currentUser().status == 'active';
    }

    function validUserData(userId, data) {
      return data.keys().hasAll([
          'uid',
          'email',
          'fullName',
          'employeeCode',
          'role',
          'status',
          'officeId',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'email',
          'fullName',
          'employeeCode',
          'role',
          'status',
          'officeId',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string &&
        data.uid == userId &&
        data.email is string &&
        data.email.size() > 3 &&
        data.email.size() <= 254 &&
        data.fullName is string &&
        data.fullName.size() >= 3 &&
        data.fullName.size() <= 100 &&
        data.employeeCode is string &&
        data.employeeCode.size() >= 3 &&
        data.employeeCode.size() <= 30 &&
        data.role in ['admin', 'employee'] &&
        data.status in ['active', 'inactive', 'pending'] &&
        (
          data.officeId == null ||
          (
            data.officeId is string &&
            data.officeId.size() >= 3 &&
            data.officeId.size() <= 50
          )
        ) &&
        (
          data.role == 'admin' ||
          data.status != 'active' ||
          data.officeId is string
        ) &&
        data.schemaVersion is int &&
        data.schemaVersion == 1 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function canReadOffice(officeId) {
      return isActiveAdmin() ||
        (
          hasProfile() &&
          currentUser().status == 'active' &&
          currentUser().officeId == officeId
        );
    }

    function validOfficeData(data) {
      return data.keys().hasAll([
          'name',
          'address',
          'location',
          'radiusMeters',
          'maxAccuracyMeters',
          'timezone',
          'active',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name',
          'address',
          'location',
          'radiusMeters',
          'maxAccuracyMeters',
          'timezone',
          'active',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ]) &&
        data.name is string &&
        data.name.size() >= 3 &&
        data.name.size() <= 100 &&
        data.address is string &&
        data.address.size() >= 5 &&
        data.address.size() <= 200 &&
        data.location is latlng &&
        data.radiusMeters is number &&
        data.radiusMeters >= 20 &&
        data.radiusMeters <= 500 &&
        data.maxAccuracyMeters is number &&
        data.maxAccuracyMeters >= 5 &&
        data.maxAccuracyMeters <= 100 &&
        data.timezone == 'America/Lima' &&
        data.active is bool &&
        data.schemaVersion is int &&
        data.schemaVersion == 1 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() &&
        (request.auth.uid == userId || isActiveAdmin());

      allow list: if isActiveAdmin();

      allow create: if isActiveAdmin() &&
        validUserData(userId, request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if isActiveAdmin() &&
        validUserData(userId, request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName',
          'employeeCode',
          'role',
          'status',
          'officeId',
          'updatedAt'
        ]) &&
        request.resource.data.updatedAt == request.time &&
        (
          request.auth.uid != userId ||
          (
            request.resource.data.role == resource.data.role &&
            request.resource.data.status == resource.data.status
          )
        );

      allow delete: if false;
    }

    match /offices/{officeId} {
      allow get: if canReadOffice(officeId);
      allow list: if isActiveAdmin();

      allow create: if isActiveAdmin() &&
        validOfficeData(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if isActiveAdmin() &&
        validOfficeData(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'address',
          'location',
          'radiusMeters',
          'maxAccuracyMeters',
          'timezone',
          'active',
          'updatedAt'
        ]) &&
        request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}